+    /// Attach a synced virtual keyboard that will never receive a keymap.
+    ///
+    /// zwp_virtual_keyboard_v1.keymap carries a file descriptor. A window
+    /// manager written in a language whose Wayland client cannot pass fds
+    /// (for example Emacs Lisp) cannot send it, so waiting for the keymap
+    /// event would leave the virtual keyboard unattached forever and every
+    /// injected key would be dropped. Attach it now instead: SyncedVirtKb
+    /// borrows the seat's keyboard keymap, and a keymap request arriving
+    /// later still takes effect through its own queue_keymap listener.
+    fn attachWithoutKeymap(no_keymap: *NoKeymapVirtKeyboard) void {
+        const virtual_keyboard = no_keymap.virtual_keyboard;
+        assert(no_keymap.wm_sync);
+        assert(virtual_keyboard.keyboard.keymap == null);
+
+        handleVirtKeyboardDestroy(&no_keymap.destroy, &virtual_keyboard.keyboard.base);
+
+        const seat: *Seat = @ptrCast(@alignCast(virtual_keyboard.seat.data));
+        seat.attachSyncedVirtKb(virtual_keyboard);
+    }
 };
 
